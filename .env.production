# ============================================================
# StudySync Production Environment Configuration
# ============================================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (Neon DB)
# Primary branch for write operations
DATABASE_URL=postgresql://neondb_owner:npg_5XyCHuPIZ2cK@ep-plain-fire-at0bpny2-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Child branch for read operations
DATABASE_READ_URL=postgresql://neondb_owner:npg_5XyCHuPIZ2cK@ep-rough-salad-atg0en89-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_SESSION_TTL=604800

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Frontend Configuration
FRONTEND_URL=https://studysync.com

# Python RAG Backend
PYTHON_RAG_PORT=8000

# File Upload Configuration
MAX_FILE_SIZE=25MB
UPLOAD_DIR=/app/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_UPLOAD_MAX=20

# WebSocket Configuration
WEBSOCKET_PORT=5000

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=https://studysync.com
